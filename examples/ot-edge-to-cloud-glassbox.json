{
  "id": "arch_tpl_edge_iot",
  "tenant_id": "tenant_templates",
  "name": "OT / Edge-to-Cloud, glass-box (demo)",
  "version": 1,
  "attrs": {
    "owner": "Head of Plant Engineering",
    "description": "Template: OT telemetry pipeline. Attested edge devices publish to an edge gateway running an on-device model; northbound traffic crosses a data diode and site DMZ conduit into IoT Operations/IoT Hub, then Event Hubs and a private Blob telemetry lake in Switzerland North.",
    "criticality": "high",
    "allowed_regions": ["switzerlandnorth", "switzerlandwest"],
    "regimes": ["CRA", "CH-ISG", "IEC", "DORA"],
    "incident_reporting": "Cyber attacks on critical infrastructure reported to the NCSC within 24 h of discovery (ISG Art. 74a-c); DORA Art. 19 major-incident reporting via the ICT risk function; plant SOC on-call escalates within 1 h.",
    "dr_tested_at": "2026-03-31"
  },
  "groups": [
    { "id": "g_site", "kind": "zone", "name": "Site – Plant A", "node_ids": ["n_plc1", "n_cam2", "n_vib3", "n_egw", "n_emodel", "n_product"],
      "attrs": { "region": "ch", "description": "Production zone (IEC 62443 zone), Plant A, Switzerland." } },
    { "id": "g_conduit", "kind": "zone", "name": "Conduit – Plant A DMZ", "node_ids": ["n_diode", "n_dmz"],
      "attrs": { "region": "ch", "description": "Unidirectional conduit between production zone and cloud." } },
    { "id": "g_cloud", "kind": "zone", "name": "Cloud – Switzerland North", "node_ids": ["n_broker", "n_eh", "n_blob", "n_logs"],
      "attrs": { "region": "switzerlandnorth" } },
    { "id": "g_plant_a", "kind": "site", "name": "Plant A", "node_ids": ["n_plc1", "n_cam2", "n_vib3", "n_egw", "n_emodel", "n_product", "n_diode", "n_dmz"] },
    { "id": "g_ot_tb", "kind": "trust_boundary", "name": "OT / IT boundary", "node_ids": ["n_diode", "n_dmz"] }
  ],
  "nodes": [
    { "id": "n_plc1", "type": "edge_device", "name": "PLC – line 1", "layer": "edge", "zone": "g_site", "position": { "x": 40, "y": 80 }, "source": "design",
