    { "id": "n_cam2", "type": "edge_device", "name": "Vision camera – line 2", "layer": "edge", "zone": "g_site", "position": { "x": 40, "y": 200 }, "source": "design",
      "attrs": { "site": "Plant A", "attestation": "tpm", "secure_boot": true, "disk_encryption": true, "ota_signed": true, "egress_policy": true, "cra_scope": true, "sbom": true, "version": "fw 2.8.0" } },
    { "id": "n_vib3", "type": "edge_device", "name": "Vibration sensor array – line 3", "layer": "edge", "zone": "g_site", "position": { "x": 40, "y": 320 }, "source": "design",
      "attrs": { "site": "Plant A", "attestation": "secure_element", "secure_boot": true, "disk_encryption": true, "ota_signed": true, "egress_policy": true, "cra_scope": true, "sbom": true, "version": "fw 1.9.3" } },
    { "id": "n_product", "type": "product", "name": "Edge appliance (product)", "layer": "edge", "zone": "g_site", "position": { "x": 40, "y": 440 }, "source": "design",
      "attrs": { "cra_scope": true, "sbom": true, "secure_boot": true, "ota_signed": true, "version": "2.3.0", "owner": "Head of Plant Engineering" } },
    { "id": "n_egw", "type": "edge_gateway", "name": "Plant edge gateway", "layer": "edge", "zone": "g_site", "position": { "x": 260, "y": 200 }, "source": "design",
      "attrs": { "site": "Plant A", "attestation": "tpm", "secure_boot": true, "disk_encryption": true, "ota_signed": true, "egress_policy": true, "cra_scope": true, "sbom": true, "version": "2.3.0", "owner": "Head of Plant Engineering" } },
    { "id": "n_emodel", "type": "edge_model", "name": "Anomaly detection model (ONNX, on-device)", "layer": "edge", "zone": "g_site", "position": { "x": 480, "y": 80 }, "source": "design",
      "attrs": { "purpose": "Detects vibration and vision anomalies locally; only scores and aggregates leave the site.", "owner": "Head of Plant Engineering", "version": "1.4.0" } },
    { "id": "n_diode", "type": "data_diode", "name": "Data diode (unidirectional, site → cloud)", "layer": "network", "zone": "g_conduit", "position": { "x": 480, "y": 200 }, "source": "design",
      "attrs": {} },
    { "id": "n_dmz", "type": "dmz", "name": "Site DMZ (MQTT relay)", "layer": "network", "zone": "g_conduit", "position": { "x": 700, "y": 200 }, "source": "design",
      "attrs": {} },
    { "id": "n_broker", "type": "broker", "name": "IoT Operations / IoT Hub (MQTT broker)", "layer": "platform", "zone": "g_cloud", "position": { "x": 920, "y": 200 }, "source": "design",
      "attrs": { "region": "switzerlandnorth", "network_exposure": "private" } },
    { "id": "n_eh", "type": "queue", "name": "Event Hubs (telemetry)", "layer": "platform", "zone": "g_cloud", "position": { "x": 1140, "y": 200 }, "source": "design",
      "attrs": { "region": "switzerlandnorth", "network_exposure": "private" } },
    { "id": "n_blob", "type": "datastore", "name": "Telemetry lake (Blob, Capture)", "layer": "data", "zone": "g_cloud", "position": { "x": 1360, "y": 200 }, "source": "design",
      "attrs": { "engine": "blob", "data_class": "confidential", "region": "switzerlandnorth", "network_exposure": "private", "encryption_key": "cmk", "backup": true, "geo_redundant": true, "criticality": "high", "retention_days": 1825 } },
    { "id": "n_logs", "type": "log_sink", "name": "Log Analytics (immutable archive)", "layer": "platform", "zone": "g_cloud", "position": { "x": 1360, "y": 320 }, "source": "design",
      "attrs": { "retention_days": 3650, "immutable": true, "region": "switzerlandnorth" } }
  ],
  "edges": [
    { "id": "e_plc1_egw",    "from": "n_plc1",   "to": "n_egw",    "kind": "publishes", "protocol": "opcua", "auth": "mtls",             "encryption": "mtls", "data_class": "internal",     "attrs": {} },
    { "id": "e_cam2_egw",    "from": "n_cam2",   "to": "n_egw",    "kind": "publishes", "protocol": "mqtt",  "auth": "mtls",             "encryption": "mtls", "data_class": "confidential", "attrs": {} },
    { "id": "e_vib3_egw",    "from": "n_vib3",   "to": "n_egw",    "kind": "publishes", "protocol": "mqtt",  "auth": "mtls",             "encryption": "mtls", "data_class": "internal",     "attrs": {} },
    { "id": "e_egw_emodel",  "from": "n_egw",    "to": "n_emodel", "kind": "calls",     "protocol": "grpc",  "auth": "mtls",             "encryption": "mtls", "data_class": "confidential", "label": "local inference", "attrs": {} },
    { "id": "e_egw_diode",   "from": "n_egw",    "to": "n_diode",  "kind": "publishes", "protocol": "mqtt",  "auth": "mtls",             "encryption": "mtls", "data_class": "confidential", "attrs": {} },
    { "id": "e_diode_dmz",   "from": "n_diode",  "to": "n_dmz",    "kind": "flows",     "protocol": "mqtt",  "auth": "mtls",             "encryption": "mtls", "data_class": "confidential", "attrs": {} },
    { "id": "e_dmz_broker",  "from": "n_dmz",    "to": "n_broker", "kind": "publishes", "protocol": "mqtt",  "auth": "mtls",             "encryption": "mtls", "data_class": "confidential", "label": "X.509 device identity", "attrs": {} },
    { "id": "e_broker_eh",   "from": "n_broker", "to": "n_eh",     "kind": "publishes", "protocol": "amqp",  "auth": "managed_identity", "encryption": "tls",  "data_class": "confidential", "attrs": {} },
    { "id": "e_eh_blob",     "from": "n_eh",     "to": "n_blob",   "kind": "writes",    "protocol": "https", "auth": "managed_identity", "encryption": "tls",  "data_class": "confidential", "label": "Event Hubs Capture", "attrs": {} },
    { "id": "e_broker_logs", "from": "n_broker", "to": "n_logs",   "kind": "writes",    "protocol": "https", "auth": "managed_identity", "encryption": "tls",  "data_class": "internal",     "attrs": {} },
    { "id": "e_eh_logs",     "from": "n_eh",     "to": "n_logs",   "kind": "writes",    "protocol": "https", "auth": "managed_identity", "encryption": "tls",  "data_class": "internal",     "attrs": {} }
  ],
  "findings": [],
  "evidence": []
