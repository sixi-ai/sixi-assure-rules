{
  "id": "arch_tpl_rag_chatbot",
  "tenant_id": "tenant_templates",
  "name": "Azure RAG chatbot – retail banking",
  "version": 1,
  "attrs": {
    "owner": "Head of Digital Channels",
    "description": "Template: customer-facing RAG chatbot on Azure (Front Door/WAF → chat web app → APIM → advisor agent → AI gateway → Azure OpenAI in Foundry; grounding on AI Search and Customer SQL). Good twin of rag-chatbot-bad.",
    "criticality": "high",
    "ai_act_tier": "limited",
    "materiality": "high",
    "allowed_regions": ["switzerlandnorth", "switzerlandwest"],
    "regimes": ["FINMA", "AIACT", "FADP", "MCSB"],
    "incident_reporting": "Security incidents are escalated to the CISO on-call within 1 h; FINMA notification (Rundschreiben 2023/1 Rz-Cyber) within 24 h of classification as material; FADP breach assessment by the DPO.",
    "dr_tested_at": "2026-06-30"
  },
  "groups": [
    { "id": "g_users", "kind": "zone", "name": "Users", "node_ids": ["n_user"] },
    { "id": "g_cloud", "kind": "zone", "name": "Azure – Switzerland North", "node_ids": ["n_waf", "n_web", "n_apim", "n_agent", "n_aigw", "n_llm", "n_search", "n_sql", "n_kv", "n_logs", "n_eval", "n_entra"],
      "attrs": { "region": "switzerlandnorth" } },
    { "id": "g_agent_tb", "kind": "trust_boundary", "name": "Agent runtime", "node_ids": ["n_agent", "n_aigw"] }
  ],
  "nodes": [
    { "id": "n_user", "type": "user", "name": "Retail customer", "layer": "human", "zone": "g_users", "position": { "x": 40, "y": 200 }, "source": "design",
      "attrs": { "population": "customer", "mfa": true } },
    { "id": "n_waf", "type": "gateway", "name": "Front Door + WAF", "layer": "network", "zone": "g_cloud", "position": { "x": 260, "y": 200 }, "source": "design",
      "attrs": { "kind": "waf", "logging": true } },
    { "id": "n_entra", "type": "identity_provider", "name": "Entra ID (customer + workload identities)", "layer": "identity", "zone": "g_cloud", "position": { "x": 260, "y": 440 }, "source": "design",
      "attrs": {} },
    { "id": "n_web", "type": "app", "name": "Chat web app", "layer": "app", "zone": "g_cloud", "position": { "x": 480, "y": 200 }, "source": "design",
      "attrs": { "exposure": "public", "waf": true, "authn": "oidc", "secrets_in": "secret_store", "criticality": "high", "region": "switzerlandnorth" } },
    { "id": "n_kv", "type": "secret_store", "name": "Key Vault", "layer": "identity", "zone": "g_cloud", "position": { "x": 480, "y": 440 }, "source": "design",
      "attrs": { "region": "switzerlandnorth" } },
    { "id": "n_apim", "type": "gateway", "name": "APIM gateway", "layer": "platform", "zone": "g_cloud", "position": { "x": 700, "y": 200 }, "source": "design",
      "attrs": { "kind": "api", "logging": true, "region": "switzerlandnorth" } },
    { "id": "n_agent", "type": "agent", "name": "Advisor agent", "layer": "ai", "zone": "g_cloud", "position": { "x": 920, "y": 200 }, "source": "design",
      "attrs": { "output_marking": true, "identity": "agent_id", "autonomy": "assisted", "purpose": "Answers retail-banking product and account questions from customers, grounded on approved documents and the customer's own data.", "owner": "Head of Digital Channels", "materiality": "high", "kill_switch": true, "ai_disclosure": true, "content_safety": true, "rate_limit": true, "criticality": "high", "region": "switzerlandnorth" } },
    { "id": "n_logs", "type": "log_sink", "name": "Log Analytics (immutable archive)", "layer": "platform", "zone": "g_cloud", "position": { "x": 920, "y": 440 }, "source": "design",
      "attrs": { "retention_days": 3650, "immutable": true, "region": "switzerlandnorth" } },
    { "id": "n_eval", "type": "evaluation", "name": "Evaluation & drift monitoring (Foundry evaluations)", "layer": "ai", "zone": "g_cloud", "position": { "x": 920, "y": 560 }, "source": "design",
      "attrs": { "evaluates": ["accuracy", "drift", "toxicity"], "owner": "Head of Digital Channels", "purpose": "Offline golden-set evaluation and weekly drift checks on logged prompts/responses." } },
    { "id": "n_aigw", "type": "gateway", "name": "AI gateway (APIM GenAI policies)", "layer": "platform", "zone": "g_cloud", "position": { "x": 1140, "y": 80 }, "source": "design",
      "attrs": { "kind": "ai", "logging": true, "token_limits": true, "content_safety": true, "semantic_cache": false, "region": "switzerlandnorth" } },
    { "id": "n_search", "type": "vector_index", "name": "AI Search index", "layer": "data", "zone": "g_cloud", "position": { "x": 1140, "y": 200 }, "source": "design",
      "attrs": { "data_class": "cid", "acl_trimming": true, "redaction": true, "classification": true, "region": "switzerlandnorth" } },
    { "id": "n_sql", "type": "datastore", "name": "Customer SQL DB", "layer": "data", "zone": "g_cloud", "position": { "x": 1140, "y": 320 }, "source": "design",
      "attrs": { "engine": "azure_sql", "data_class": "cid", "region": "switzerlandnorth", "network_exposure": "private", "encryption_key": "cmk", "backup": true, "geo_redundant": true, "criticality": "critical", "rto_min": 60, "rpo_min": 15, "retention_days": 3650 } },
    { "id": "n_llm", "type": "llm_endpoint", "name": "Azure OpenAI (Foundry)", "layer": "ai", "zone": "g_cloud", "position": { "x": 1360, "y": 80 }, "source": "design",
      "attrs": { "model_card": true, "provider": "azure", "model": "gpt-4.1", "region": "switzerlandnorth", "network": "private", "content_safety": true, "outsourcing_registered": true, "exit_strategy": true, "purpose": "Generation model for the advisor agent.", "owner": "Head of Digital Channels", "materiality": "high", "criticality": "high" } }
  ],
  "edges": [
    { "id": "e_user_waf",     "from": "n_user",   "to": "n_waf",    "kind": "calls",         "protocol": "https", "auth": "oauth_client",     "encryption": "tls", "data_class": "cid",      "attrs": {} },
    { "id": "e_waf_web",      "from": "n_waf",    "to": "n_web",    "kind": "calls",         "protocol": "https", "auth": "oauth_client",     "encryption": "tls", "data_class": "cid",      "attrs": {} },
    { "id": "e_web_entra",    "from": "n_web",    "to": "n_entra",  "kind": "authenticates", "protocol": "https", "auth": "oauth_client",     "encryption": "tls", "data_class": "pii",      "attrs": {} },
    { "id": "e_web_apim",     "from": "n_web",    "to": "n_apim",   "kind": "calls",         "protocol": "https", "auth": "oauth_client",     "encryption": "tls", "data_class": "cid",      "attrs": {} },
    { "id": "e_apim_agent",   "from": "n_apim",   "to": "n_agent",  "kind": "calls",         "protocol": "https", "auth": "managed_identity", "encryption": "tls", "data_class": "cid",      "attrs": { "logged": true } },
    { "id": "e_agent_entra",  "from": "n_agent",  "to": "n_entra",  "kind": "authenticates", "protocol": "https", "auth": "agent_id",         "encryption": "tls", "data_class": "internal", "attrs": {} },
    { "id": "e_agent_aigw",   "from": "n_agent",  "to": "n_aigw",   "kind": "calls",         "protocol": "https", "auth": "agent_id",         "encryption": "tls", "data_class": "cid",      "attrs": { "logged": true } },
    { "id": "e_aigw_llm",     "from": "n_aigw",   "to": "n_llm",    "kind": "calls",         "protocol": "https", "auth": "managed_identity", "encryption": "tls", "data_class": "cid",      "attrs": { "logged": true, "prompt_contains": "cid" } },
    { "id": "e_agent_search", "from": "n_agent",  "to": "n_search", "kind": "reads",         "protocol": "https", "auth": "agent_id",         "encryption": "tls", "data_class": "cid",      "attrs": { "logged": true } },
    { "id": "e_agent_sql",    "from": "n_agent",  "to": "n_sql",    "kind": "reads",         "protocol": "tds",   "auth": "agent_id",         "encryption": "tls", "data_class": "cid",      "attrs": { "logged": true } },
    { "id": "e_sql_search",   "from": "n_sql",    "to": "n_search", "kind": "flows",         "protocol": "https", "auth": "managed_identity", "encryption": "tls", "data_class": "cid",      "label": "indexer (classified + redacted)", "attrs": {} },
    { "id": "e_agent_kv",     "from": "n_agent",  "to": "n_kv",     "kind": "reads",         "protocol": "https", "auth": "agent_id",         "encryption": "tls", "data_class": "secret",   "attrs": {} },
    { "id": "e_web_kv",       "from": "n_web",    "to": "n_kv",     "kind": "reads",         "protocol": "https", "auth": "managed_identity", "encryption": "tls", "data_class": "secret",   "attrs": {} },
    { "id": "e_agent_logs",   "from": "n_agent",  "to": "n_logs",   "kind": "writes",        "protocol": "https", "auth": "agent_id",         "encryption": "tls", "data_class": "internal", "attrs": {} },
    { "id": "e_aigw_logs",    "from": "n_aigw",   "to": "n_logs",   "kind": "writes",        "protocol": "https", "auth": "managed_identity", "encryption": "tls", "data_class": "cid",      "label": "prompt/response log", "attrs": {} },
    { "id": "e_apim_logs",    "from": "n_apim",   "to": "n_logs",   "kind": "writes",        "protocol": "https", "auth": "managed_identity", "encryption": "tls", "data_class": "internal", "attrs": {} },
    { "id": "e_eval_logs",    "from": "n_eval",   "to": "n_logs",   "kind": "reads",         "protocol": "https", "auth": "managed_identity", "encryption": "tls", "data_class": "cid",      "attrs": {} }
  ],
  "findings": [],
  "evidence": []
}
