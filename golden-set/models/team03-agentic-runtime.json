      "name": "Triage agent",
      "layer": "ai",
      "source": "design",
      "attrs": {
        "identity": "agent_id",
        "purpose": "Sorts incoming requests and looks up documents and the code runner for the analysts.",
        "owner": "Head of Agent Platform",
        "materiality": "medium",
        "kill_switch": true,
        "rate_limit": true,
        "ai_disclosure": true,
        "content_safety": true,
        "autonomy": "assisted"
      }
    },
    {
      "id": "n_reviewer",
