{
  "schema_version": "1.2",
  "id": "arch_gs_team03_agentic_runtime",
  "tenant_id": "templates",
  "name": "Agentic runtime and supply chain",
  "version": 1,
  "attrs": {
    "owner": "Head of Agent Platform",
    "description": "Agentic runtime design (swarm team 03): four agents behind an AI gateway, MCP servers behind an MCP gateway, a verified tool registry, screened inputs, approvals under separate identities with a declared scope, scoped and guarded memories, and the web search tool behind an egress gateway.",
    "ai_act_tier": "limited",
    "regimes": [
      "OWASP",
      "AIACT"
    ],
    "allowed_regions": [
      "switzerlandnorth",
      "switzerlandwest"
    ]
  },
  "groups": [],
  "nodes": [
