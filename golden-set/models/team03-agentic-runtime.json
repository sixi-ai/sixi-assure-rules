      "layer": "ai",
      "source": "design",
      "attrs": {
        "identity": "agent_id",
        "purpose": "Reviews partner events and files tickets; consequential ledger entries pass an approval.",
        "owner": "Head of Agent Platform",
        "materiality": "medium",
        "kill_switch": true,
        "rate_limit": true,
        "ai_disclosure": true,
        "content_safety": true,
        "autonomy": "semi"
