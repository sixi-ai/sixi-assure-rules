{
  "schema_version": "1.3",
  "id": "arch_tpl_water_dispatch",
  "tenant_id": "tenant_templates",
  "version": 1,
  "name": "Water dispatch with AI-assisted pump scheduling (manual fallback)",
  "attrs": {
    "owner": "Head of Network Operations",
    "criticality": "high",
    "regimes": [
      "NIS2"
    ],
    "allowed_regions": [
      "switzerlandnorth",
      "switzerlandwest"
    ],
    "description": "Template (ADR-105): a water utility's dispatch. A scheduling agent proposes pump schedules and a triage agent reads network telemetry; the shift engineer can run the schedule from the dispatch console without either agent; the model has a recorded exit strategy, runs are budgeted, a quarantine segment is declared and the degraded mode without the agents is rehearsed.",
    "incident_reporting": "Significant incidents go to the national CSIRT through the security office: early warning within 24 h, notification within 72 h, final report within a month; the shift engineer may switch the agents off at any time.",
    "dr_tested_at": "2026-06-15",
    "degraded_mode_tested_at": "2026-09-20",
    "decisions": [
      {
        "id": "ADR-001",
        "title": "NIS2 applies as transposed by the national act named in the register",
        "status": "accepted",
        "context": "The utility runs an essential drinking-water service in an EU Member State; the Directive binds through the national transposition.",
        "decision": "Art. 21 and Art. 23 are read as transposed by the national act the utility names in its compliance register, with the registration with the national authority recorded there.",
        "consequences": "Every NIS2 row names the act from the register; a change of the act reopens this decision.",
        "citations": [
          {
            "kind": "clause",
            "id": "NIS2:2022/2555:Art41"
          },
          {
            "kind": "clause",
            "id": "NIS2:2022/2555:Art21"
          }
        ],
        "proposed_by": "Head of Network Operations",
        "decided_by": "Head of Network Operations",
        "decided_at": "2026-09-20T08:00:00Z"
      }
    ]
  },
