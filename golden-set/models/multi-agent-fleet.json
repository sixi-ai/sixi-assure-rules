  "attrs": {
    "owner": "Head of Research Platforms",
    "description": "Template: an orchestrator agent delegates (A2A, on-behalf-of) to an autonomous research worker and an assisted drafting worker. Workers reach MCP servers only through an authenticated MCP gateway; every agent reaches the LLM only through the AI gateway.",
    "criticality": "high",
    "ai_act_tier": "limited",
    "materiality": "high",
    "allowed_regions": ["switzerlandnorth", "switzerlandwest"],
    "regimes": ["FINMA", "AIACT", "OWASP", "MSFT"],
    "incident_reporting": "Agent misbehaviour or prompt-injection incidents are escalated to the AI risk function within 2 h; the fleet-wide kill switch is operated by the platform duty engineer; FINMA notification within 24 h if material.",
    "dr_tested_at": "2026-06-10"
  },
  "groups": [
    { "id": "g_users", "kind": "zone", "name": "Employees", "node_ids": ["n_user"] },
    { "id": "g_cloud", "kind": "zone", "name": "Azure – Switzerland North", "node_ids": ["n_app", "n_entra", "n_orch", "n_kv", "n_w_research", "n_w_draft", "n_aigw", "n_llm", "n_mcpgw", "n_mcp_docs", "n_tool_docs", "n_logs", "n_eval"],
