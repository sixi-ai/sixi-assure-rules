{
  "id": "arch_tpl_glassbox_ot_agent",
  "tenant_id": "tenant_templates",
  "version": 1,
  "name": "GlassBox Edge – AI assistant grounded in live OT telemetry",
  "attrs": {
    "owner": "Head of Manufacturing IT",
    "criticality": "high",
    "materiality": "medium",
    "ai_act_tier": "limited",
    "regimes": [
      "AIACT",
      "CRA",
      "NIS2",
      "IEC",
      "ISO",
      "FADP",
      "FDA",
      "EU-GMP",
      "MR",
      "GAMP"
    ],
    "allowed_regions": [
      "switzerlandnorth",
      "switzerlandwest"
    ],
    "description": "AI assistant for the operators and QA of a fictional biopharma plant (GlassBox Pharma AG, Basel): two bioreactor lines on two NVIDIA Jetson edge nodes and Azure. The model never touches the PLC: the agent proposes a command, a human approves it under their own identity, a broker signs it with a key the agent cannot reach, and the Jetson validates signature, freshness, nonce, allow-list, range and state before it writes.",
    "incident_reporting": "CRA Art. 14: actively exploited vulnerabilities reported through the PSIRT within 24 h; NIS2 Art. 23: early warning to the national CSIRT within 24 h via the plant CSIRT; a budget or attack alert stops ingress (kill switch).",
    "substantial_modification": "not_substantial",
    "decisions": [
      {
        "id": "ADR-001",
        "title": "The model never touches the PLC",
        "status": "accepted",
        "context": "The assistant reads live process data and may suggest actions on a GMP production line.",
        "decision": "AI components only propose commands. A human approves each command in the approval console under their own identity; the command broker, which no AI component can call, signs it and sends it cloud-to-device; the validator on the Jetson checks signature, freshness, nonce, allow-list, range and machine state before it writes the PLC.",
        "consequences": "Every machine action has a named approver and a device verdict on the audit trail; a compromised prompt can at most propose.",
        "citations": [
          {
            "kind": "clause",
            "id": "AIACT:2024/1689:Art14"
          },
          {
            "kind": "clause",
            "id": "IEC:62443-3-3:Standard"
          },
          {
            "kind": "clause",
            "id": "OWASP:LLMTop10:LLM06"
          }
        ],
        "proposed_by": "Head of Manufacturing IT",
        "decided_by": "Head of Manufacturing IT",
        "decided_at": "2026-09-15T08:00:00Z"
      },
      {
        "id": "ADR-002",
        "title": "AI Act: limited risk, Art. 50 transparency",
        "status": "accepted",
        "context": "The assistant explains process data and drafts reports; people decide on every command and every batch.",
        "decision": "Classify the assistant as a limited-risk AI system: disclose the AI in the interface and mark drafted reports as AI-generated. It is not a safety component of the machine; if it became one, the Annex I route applies.",
        "consequences": "Disclosure and output marking are design attributes the rules check; the classification is revisited when the intended purpose changes.",
        "citations": [
          {
            "kind": "clause",
            "id": "AIACT:2024/1689:Art50(1)"
          },
          {
            "kind": "clause",
            "id": "AIACT:2024/1689:Art50(2)"
          }
        ],
        "proposed_by": "Head of Manufacturing IT",
        "decided_by": "Head of Manufacturing IT",
        "decided_at": "2026-09-15T08:00:00Z"
      },
      {
        "id": "ADR-003",
        "title": "Command-signing keys in a managed HSM, verified on the device",
        "status": "accepted",
        "context": "The demo signs commands with a per-device HMAC key held in Key Vault.",
        "decision": "In production, sign with asymmetric keys in Key Vault Managed HSM reachable only by the broker's identity; each Jetson verifies with the public key.",
        "consequences": "No secret on the device can forge a command; key rotation does not touch the devices' trust anchor.",
        "citations": [
          {
            "kind": "clause",
            "id": "ISO:27001:A.8.24"
          },
          {
            "kind": "clause",
            "id": "CRA:2024/2847:AnnexI"
          }
        ],
        "proposed_by": "Head of Manufacturing IT",
        "decided_by": "Head of Manufacturing IT",
        "decided_at": "2026-09-15T08:00:00Z"
      },
      {
        "id": "ADR-004",
        "title": "Machinery Regulation: the command path is not a substantial modification",
        "status": "accepted",
        "context": "Adding an AI assistant that proposes setpoints to existing bioreactor skids could make the plant the manufacturer of the modified machinery (Art. 18).",
        "decision": "Assessed with the skids' risk assessment: commands stay inside the manufacturer's allow-list, value ranges and machine states, checked on the device before any write, so the path creates no new hazard and needs no new guard or protective device. The validator records every command and its verdict in a tracing log kept five years.",
        "consequences": "The plant does not take on the manufacturer's obligations for the skids; any change to the allow-list, the ranges or the validator reopens the assessment.",
        "citations": [
          {
            "kind": "clause",
            "id": "MR:2023/1230:Art3(16)"
          },
          {
            "kind": "clause",
            "id": "MR:2023/1230:Art18"
          },
          {
            "kind": "clause",
            "id": "MR:2023/1230:AnnexIII-1.2.1(f)"
          }
        ],
        "proposed_by": "Head of Manufacturing IT",
        "decided_by": "Head of Manufacturing IT",
        "decided_at": "2026-09-15T08:00:00Z"
      }
    ]
  },
